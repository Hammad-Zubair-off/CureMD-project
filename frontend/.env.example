# Stripe publishable key (safe to expose in the browser)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# Local/dev helpers
VITE_SKIP_PAYMENT=true
VITE_TELEMEDICINE_ALLOW_UPCOMING_JOIN=true
VITE_TELEMEDICINE_ALLOW_UPCOMING_START=true
# Optional: force camera test UI without a live appointment
# VITE_TELEMEDICINE_CAMERA_TEST_MODE=false

# Optional API base (Vite proxy to gateway is used by default)
# VITE_API_URL=http://localhost:80/api
