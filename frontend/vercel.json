{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "https://cure-md-project-sigma.vercel.app/api/auth/:path*" },
    { "source": "/api/patients/:path*", "destination": "https://curemd-patient.vercel.app/api/patients/:path*" },
    { "source": "/api/doctors/:path*", "destination": "https://curemd-doctor.vercel.app/api/doctors/:path*" },
    { "source": "/api/appointments/:path*", "destination": "https://curemd-appointment.vercel.app/api/appointments/:path*" },
    { "source": "/api/payments/:path*", "destination": "https://curemd-payment.vercel.app/api/payments/:path*" },
    { "source": "/api/notifications/:path*", "destination": "https://curemd-notification.vercel.app/api/notifications/:path*" },
    { "source": "/api/telemedicine/:path*", "destination": "https://curemd-telemedicine.vercel.app/api/telemedicine/:path*" },
    { "source": "/api/ai/:path*", "destination": "https://curemd-ai-symptom.vercel.app/api/ai/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
