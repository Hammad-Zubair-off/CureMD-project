PORT=3004
SERVICE_NAME=appointment
NODE_ENV=development
# Local Docker: mongodb://mongo:27017/appointment-db   |   Vercel: MongoDB Atlas SRV string
MONGODB_URI=mongodb://mongo:27017/appointment-db
JWT_SECRET=replace_with_shared_jwt_secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
INTERNAL_SECRET=replace_with_shared_internal_secret
# Set true to skip Stripe payment during local booking
SKIP_PAYMENT=true
# Async events. Leave QSTASH_* empty for local dev (direct HTTP + no signature check).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Peer service URLs (Docker Compose network defaults shown)
# PATIENT_SERVICE_URL=http://patient-service:3002
# DOCTOR_SERVICE_URL=http://doctor-service:3003
# NOTIFICATION_SERVICE_URL=http://notification-service:3006
# PAYMENT_SERVICE_URL=http://payment-service:3005
