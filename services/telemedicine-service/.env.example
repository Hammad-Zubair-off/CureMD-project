PORT=3007
SERVICE_NAME=telemedicine
NODE_ENV=development
# Local Docker: mongodb://mongo:27017/telemedicine-db   |   Vercel: MongoDB Atlas SRV string
MONGODB_URI=mongodb://mongo:27017/telemedicine-db
JWT_SECRET=replace_with_shared_jwt_secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
FRONTEND_URL=http://localhost:5173
# Set true to auto-create sessions in local/dev flows
TELEMEDICINE_DEV_AUTO_SESSION=true
# Optional (has defaults in Docker Compose network)
# APPOINTMENT_SERVICE_URL=http://appointment-service:3004
