PORT=3006
SERVICE_NAME=notification
NODE_ENV=development
# Local Docker: mongodb://mongo:27017/notification-db   |   Vercel: MongoDB Atlas SRV string
MONGODB_URI=mongodb://mongo:27017/notification-db
JWT_SECRET=replace_with_shared_jwt_secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_EMAIL=noreply@example.com
BREVO_FROM_NAME=Smart Healthcare
# Optional SMS (Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+10000000000
# QStash inbound signature verification. Leave empty for local dev (checks skipped).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
