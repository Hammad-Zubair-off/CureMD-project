PORT=3002
SERVICE_NAME=patient
NODE_ENV=development
# Local Docker: mongodb://mongo:27017/patient_db   |   Vercel: MongoDB Atlas SRV string
MONGODB_URI=mongodb://mongo:27017/patient_db
JWT_SECRET=replace_with_shared_jwt_secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Async events. Leave QSTASH_TOKEN empty for local dev (direct HTTP is used instead).
QSTASH_TOKEN=
# Optional (Docker Compose network defaults shown)
# APPOINTMENT_SERVICE_URL=http://appointment-service:3004
# NOTIFICATION_SERVICE_URL=http://notification-service:3006
