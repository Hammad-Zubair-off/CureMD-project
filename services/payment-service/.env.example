PORT=3005
SERVICE_NAME=payment
NODE_ENV=development
# Local Docker: mongodb://mongo:27017/payment-db   |   Vercel: MongoDB Atlas SRV string
MONGODB_URI=mongodb://mongo:27017/payment-db
JWT_SECRET=replace_with_shared_jwt_secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
INTERNAL_SECRET=replace_with_shared_internal_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Async events. Leave QSTASH_* empty for local dev (direct HTTP + no signature check).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Peer service URLs (Docker Compose network defaults shown)
# APPOINTMENT_SERVICE_URL=http://appointment-service:3004
# NOTIFICATION_SERVICE_URL=http://notification-service:3006
